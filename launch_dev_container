#!/usr/bin/env bash
set -euo pipefail

if ! command -v devcontainer >/dev/null 2>&1; then
    printf 'Error: the devcontainer CLI is not installed or not on PATH.\n' >&2
    exit 127
fi

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
workspace_folder="$script_dir"

exec devcontainer up --workspace-folder "$workspace_folder" "$@"
