#!/usr/bin/env bash
set -euo pipefail

# If settings or image change, run with: --build-no-cache --remove-existing-container

if ! command -v devcontainer >/dev/null 2>&1; then
    printf 'Error: the devcontainer CLI is not installed or not on PATH.\n' >&2
    exit 127
fi

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
workspace_folder="$script_dir"

source "$script_dir/dev_container_utils"
DEVCONTAINER_HOSTNAME="$(get_next_dev_container_name)"
DEVCONTAINER_SSH_PORT="$(get_dev_container_port "$DEVCONTAINER_HOSTNAME")"
export DEVCONTAINER_HOSTNAME DEVCONTAINER_SSH_PORT

# For running additional container instances, append to command line (only --id-label "instance=N" is really required):
# --id-label "instance=N" --id-label "devcontainer.config_file=$workspace_folder/.devcontainer/devcontainer.json" --id-label "devcontainer.local_folder=$workspace_folder"

exec devcontainer up --workspace-folder "$workspace_folder" "$@"
