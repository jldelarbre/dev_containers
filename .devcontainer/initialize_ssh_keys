#!/usr/bin/env bash
set -euo pipefail

ssh_dir="$HOME/.ssh"
private_key="$ssh_dir/dev_container"
public_key="$private_key.pub"
authorized_keys="$ssh_dir/authorized_keys"

mkdir -p "$ssh_dir"
chmod 700 "$ssh_dir"

if [[ ! -e "$private_key" && ! -e "$public_key" ]]; then
    ssh-keygen -q -t ed25519 -N '' -C dev_container -f "$private_key"
elif [[ -e "$private_key" && ! -e "$public_key" ]]; then
    ssh-keygen -y -f "$private_key" > "$public_key"
elif [[ ! -e "$private_key" && -e "$public_key" ]]; then
    printf 'Error: %s exists but its private key is missing.\n' "$public_key" >&2
    exit 1
fi

chmod 600 "$private_key"
chmod 644 "$public_key"
touch "$authorized_keys"
chmod 600 "$authorized_keys"

if ! grep -Fqx -- "$(cat "$public_key")" "$authorized_keys"; then
    cat "$public_key" >> "$authorized_keys"
fi

printf 'SSH key ready: %s\n' "$private_key"
