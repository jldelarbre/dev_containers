#!/usr/bin/env bash
set -euo pipefail

# Installation:

# curl -L -o devpod "https://github.com/loft-sh/devpod/releases/latest/download/devpod-linux-amd64" \
#   && sudo install -c -m 0755 devpod /usr/local/bin \
#   && rm -f devpod

# devpod --version

# devpod provider add docker
# devpod provider use docker

# devpod list
# devpod stop name-id
# devpod delete name-id

if ! command -v devpod >/dev/null 2>&1; then
    printf 'Error: the devpod CLI is not installed or not on PATH.\n' >&2
    exit 127
fi

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
workspace_folder="$script_dir"

source "$script_dir/dev_container_utils"
DEVCONTAINER_HOSTNAME="$(get_next_dev_container_name)"
DEVCONTAINER_SSH_PORT="$(get_dev_container_port "$DEVCONTAINER_HOSTNAME")"
export DEVCONTAINER_HOSTNAME DEVCONTAINER_SSH_PORT

# For running additional container instances, append to command line: --id id-N

exec devpod up "$workspace_folder" --ide none "$@"

